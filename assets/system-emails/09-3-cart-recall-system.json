{
  "type": 9,
  "category": 3,
  "status": 2,
  "subject": "【{{ shop.name }}】カートに商品が残っています",
  "body_html": "<table id=\"content_table\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%; background-color: #fff; font-family: -apple-system,BlinkMacSystemFont,'Hiragino Sans','Hiragino Kaku Gothic ProN','Yu Gothic',Meiryo,sans-serif;\">\n    <tbody>\n    <tr>\n        <td>\n            <style>@media only screen and (max-width:620px){.m-pad{padding-left:16px !important;padding-right:16px !important;}.m-body{font-size:16px !important;line-height:1.75 !important;} }</style>\n<table id=\"fecify_content\" align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse: collapse; width: 100%; max-width: 600px; border: 1px solid #ccc;\">\n                <tbody>\n                <tr>\n                    <td>\n                        <table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n                            <tbody>\n                            <tr>\n                                <td colspan=\"4\">\n                                </td>\n                            </tr>\n                            <tr>\n                                {%- if shop.email_logo_url %}\n                                    <td class=\"m-pad\" style=\"padding-bottom: 20px; padding-left: 35px;padding-top: 30px;\">\n                                        <img style=\"text-align: center;max-width: 100px\" width=\"{{ shop.email_logo_width }}\"\n                                             src=\"{{ shop.email_logo_url }}\" alt=\"{{ shop.name | escape }}\">\n                                    </td>\n                                {%- endif %}\n                                <td class=\"m-pad\" style=\"padding: 40px; word-break: keep-all; white-space: nowrap;\">\n                                    <div style=\"margin-bottom: 4px; font-size: 13px; color: #333; line-height: 18px; text-align: right;\">\n                                        注文番号: {{ order.order_number }}\n                                    </div>\n                                    <div style=\"font-size: 12px; color: #999; line-height: 18px; text-align: right;\">\n                                        注文日: {{ order.recalled_at }}\n                                    </div>\n                                </td>\n                            </tr>\n\n                            <tr>\n                                <td class=\"m-pad\" style=\"font-size:24px; font-weight:600; color:rgba(33,33,33,1); padding-top: 50px; padding-left: 50px; padding-right: 50px; text-align: center;\" colspan=\"4\">\n                                    カートに商品が残っています\n                                </td>\n                            </tr>\n                            <tr>\n                                <td class=\"m-pad m-body\" style=\"font-size:14px; font-weight:400; color:rgba(33,33,33,1); padding-top: 24px; text-align: center; padding-left: 50px; padding-right: 50px;\" colspan=\"4\">\n                                    {{ order.shippingAddress.first_name | escape }} {{ order.shippingAddress.last_name | escape }} 様<br>\n                                    カートに商品を追加していますが、まだご購入手続きが完了していません。<br>\n                                    引き続きご検討中でしたら、下のボタンからご注文内容をご確認ください。\n                                </td>\n                            </tr>\n                            \n                            <tr>\n                                <td style=\" height:38px; text-align: center; border-radius:19px;padding-top: 20px;\" colspan=\"4\">\n                                    <a style=\" height:38px; text-decoration: none; -webkit-box-sizing: border-box; -moz-box-sizing: border-box; box-sizing: border-box; display: inline-block; text-align:center; font-size:14px; color:#FFFFFF; background:#333; border-radius: 19px; padding-right: 41px; padding-left: 41px; line-height: 38px;\" href=\"{{ order.view_url }}\" target=\"_blank\">\n                                        カートの商品を見る\n                                    </a>\n                                </td>\n                            </tr>\n                            <tr style=\"background: #fff; text-align: center;\">\n                                <td style=\" font-size:12px;  line-height:20px; padding-top: 5px;\" colspan=\"4\">\n                                    <span style=\"color:rgba(156,156,156,1);\">または</span>\n                                    <a style=\" color:#1567BB; text-decoration: underline;\" href=\"{{ shop.url }}\">\n                                        ショップを見る\n                                    </a>\n                                </td>\n                            </tr>\n                            <tr>\n                                <td style=\"font-size:14px; font-weight:400; color:rgba(33,33,33,1); text-align: center; padding-bottom: 32px;\" colspan=\"2\"></td>\n                            </tr>\n                            </tbody>\n                        </table>\n                        <table id=\"order-detail\" align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n                            <tbody>\n                            <tr>\n                                <td class=\"m-pad\" style=\"padding: 0 45px;\">\n                                    <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse: collapse;border-top: 1px solid #E5E5E5;\">\n                                        <tbody>\n                                        <tr>\n                                            <td style=\"padding-top: 40px;font-size:16px;font-weight:500;color:#212121;line-height:22px;\">\n                                                購入手続きを完了する\n                                            </td>\n                                        </tr>\n                                        <tr>\n                                            <td>\n                                                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\"\n                                                       style=\"border-collapse: collapse; width: 100%; table-layout: fixed;\">\n                                                    <tbody>\n                                                    {% for line in order.items %}\n                                                        <tr style=\"vertical-align: top;\">\n                                                            <td rowspan=\"2\" style=\"width: 105px; padding-top: 32px;\">\n                                                                <img width=\"85\"\n                                                                     src=\"{{ line.image }}\" alt=\"{{ line.product_title | escape }}\">\n                                                            </td>\n                                                            <td colspan=\"2\"\n                                                                style=\"color: #777777; font-size: 12px; line-height: 14px; padding:32px 0 0; border-bottom: 1px solid #E5E5E5;\">\n                                                                <div style=\"color: #333; font-size: 14px; line-height: 16px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; padding: 0 0 2px;\">\n                                                                    {{ line.product_title | escape }}\n                                                                </div>\n                                                                {% if line.variant_title %}\n                                                                    <div style=\"min-height: 17px; padding: 2px 0\">\n                                                                        <span>バリエーション：</span>\n                                                                        <span style=\"word-break: break-all;\">{{ line.variant_title | escape }}</span>\n                                                                    </div>\n                                                                {% endif %}\n                                                                <div style=\"min-height: 17px; padding: 2px 0\">\n                                                                    <span>単価：</span>\n                                                                    <span style=\"word-break: break-all;\">{{ order.symbol }}{{ line.curr_price }}</span>\n                                                                </div>\n                                                            </td>\n                                                        </tr>\n                                                        <tr style=\"vertical-align: top; font-size: 14px;  font-weight: 400; color: #30354D; line-height: 16px;\">\n                                                            <td style=\"text-align: left; padding: 8px 0;\">\n                                                                数量： {{ line.qty }}\n                                                            </td>\n                                                            <td style=\"text-align: right; padding: 8px 0;\">\n                                                                {{ order.symbol }}{{ line.curr_row_price }}\n                                                            </td>\n                                                        </tr>\n                                                    {% endfor %}\n                                                    </tbody>\n                                                </table>\n                                            </td>\n                                        </tr>\n                                        <tr>\n                                            <!-- just for padding -->\n                                            <td style=\"padding-bottom: 32px;\"></td>\n                                        </tr>\n                                        </tbody>\n                                    </table>\n                                </td>\n                            </tr>\n                            </tbody>\n                        </table>\n                    </td>\n                </tr>\n                <tr>\n                    <td>\n                        <!-- bottom -->\n                        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"\n                               style=\"border-collapse: collapse; width: 100%;\">\n                            <tbody>\n                            <tr>\n                                <td style=\"background-color: #F7F7F7;padding-top: 32px;padding-bottom: 10px;text-align: center;font-size:16px;font-weight:600;color:#333;line-height:22px;\">\n                                    お困りですか？お気軽にお問い合わせください。\n                                </td>\n                            </tr>\n                            <tr>\n                                <td class=\"m-pad\" style=\"background-color: #F7F7F7;padding-left: 50px;padding-right: 50px;text-align: center;font-size:14px;color:#777;line-height:21px;\">\n                                    お客様が快適にお買い物いただけるよう、私たちは最善を尽くします。<br>\n                                    ご質問やご意見などございましたら、下記メールアドレスまでお気軽にお問い合わせください。<br>\n                                    <a style=\"color: #1567BB; text-decoration: none;\"\n                                       href=\"mailto:{{ shop.email }}\" rel=\"noopener\" target=\"_blank\">【{{ shop.email }}】</a>\n                                    {% if shop.phone %}\n                                        <br>お電話： {{ shop.phone }}\n                                    {% endif %}\n                                </td>\n                            </tr>\n                            <tr>\n                                <td style=\"background-color: #F7F7F7;padding-top: 20px;padding-bottom: 32px;text-align: center;font-size:14px;color:#777;line-height:20px;\">\n                                    このメールは【{{ shop.name }}】から送信されました。\n                                </td>\n                            </tr>\n                            </tbody>\n                        </table>\n                    </td>\n                </tr>\n                </tbody>\n            </table>\n        </td>\n    </tr>\n    </tbody>\n</table>\n",
  "lang_emails": []
}
