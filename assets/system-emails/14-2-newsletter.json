{
  "type": 14,
  "category": 2,
  "status": 1,
  "subject": "【{{ shop.name }}】メールマガジンご登録ありがとうございます",
  "body_html": "<table id=\"content_table\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%; background-color: #fff; font-family: -apple-system,BlinkMacSystemFont,'Hiragino Sans','Hiragino Kaku Gothic ProN','Yu Gothic',Meiryo,sans-serif;\">\n<tbody><tr><td>\n<style>@media only screen and (max-width:620px){.m-pad{padding-left:16px !important;padding-right:16px !important;}.m-body{font-size:16px !important;line-height:1.75 !important;} }</style>\n<table id=\"main_content\" align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse: collapse; width: 100%; max-width: 600px; border: 1px solid #ccc;\">\n<tbody><tr><td>\n<table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n<tr>\n{%- if shop.email_logo_url %}\n<td class=\"m-pad\" style=\"padding: 30px 0 20px 35px;\"><img style=\"max-width: 100px\" width=\"{{ shop.email_logo_width }}\" src=\"{{ shop.email_logo_url }}\" alt=\"{{ shop.name | escape }}\"></td>\n{%- endif %}\n<td></td>\n</tr>\n</table>\n{% if register_account_img %}<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\"><tr><td><img width=\"100%\" src=\"{{ register_account_img }}\" alt=\"\"></td></tr></table>{% endif %}\n<table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n<tr><td class=\"m-pad\" style=\"font-size:24px; font-weight:600; color:#212121; padding: 50px 50px 0; text-align: center;\">メールマガジンにご登録いただきました</td></tr>\n<tr><td class=\"m-pad m-body\" style=\"font-size:14px; color:#212121; padding: 24px 50px 40px; text-align: center; line-height: 26px;\">{{ first_name | escape }} {{ last_name | escape }} 様<br><br>{{ shop.name }}のメールマガジンにご登録いただき、ありがとうございます。<br>新商品やお得なキャンペーン情報をいち早くお届けいたします。</td></tr>\n</table>\n<table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n<tr><td style=\"text-align: center; padding-bottom: 32px;\"><a style=\"display: inline-block; text-decoration: none; font-size:14px; color:#FFFFFF; background:#333; border-radius: 19px; padding: 0 41px; line-height: 38px;\" href=\"{{ shop.url }}\" target=\"_blank\" rel=\"noopener\">ショップを見る</a></td></tr>\n</table>\n<table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse; background-color: #F7F7F7;\">\n<tr><td class=\"m-pad\" style=\"padding: 32px 50px 10px; text-align: center; font-size:16px; font-weight:600; color:#333;\">ご不明な点がございましたら、お気軽にお問い合わせください。</td></tr>\n<tr><td class=\"m-pad\" style=\"padding: 0 50px; text-align: center; font-size:14px; color:#777; line-height: 21px;\">\nメール：<a href=\"mailto:{{ shop.email }}\" style=\"color: #1567BB; text-decoration: none;\">{{ shop.email }}</a>\n{% if shop.phone %}<br>お電話：{{ shop.phone }}{% endif %}\n</td></tr>\n<tr><td class=\"m-pad\" style=\"padding: 20px 50px 32px; text-align: center; font-size:14px; color:#777;\">本メールは【{{ shop.name }}】より送信されました。</td></tr>\n</table>\n</td></tr></tbody></table>\n</td></tr></tbody></table>",
  "lang_emails": []
}
