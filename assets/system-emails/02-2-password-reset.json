{
  "type": 2,
  "category": 2,
  "status": 1,
  "subject": "【{{ shop.name }}】パスワード再設定のご案内",
  "body_html": "<table id=\"content_table\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"\n       style=\"border-collapse: collapse; width: 100%; background-color: #fff; font-family: -apple-system,BlinkMacSystemFont,'Hiragino Sans','Hiragino Kaku Gothic ProN','Yu Gothic',Meiryo,sans-serif;\">\n    <tbody>\n    <tr>\n        <td>\n            <style>@media only screen and (max-width:620px){.m-pad{padding-left:16px !important;padding-right:16px !important;}.m-body{font-size:16px !important;line-height:1.75 !important;} }</style>\n<table id=\"fecify_content\" align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse: collapse; width: 100%; max-width: 600px; border: 1px solid #ccc;\">\n                <tbody>\n                <tr>\n                    <td>\n                        <table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"\n                               style=\"border-collapse: collapse;\">\n                            <tbody>\n                            <tr>\n                                {%- if shop.email_logo_url %}\n                                    <td class=\"m-pad\" style=\"padding-bottom: 20px; padding-left: 35px; padding-top: 30px;\">\n                                        <img style=\"text-align: center;max-width: 100px\" width=\"{{ shop.email_logo_width }}\"\n                                             src=\"{{ shop.email_logo_url }}\" alt=\"{{ shop.name | escape }}\">\n                                    </td>\n                                {%- endif %}\n\n                            </tr>\n\n                            <tr>\n                                <td class=\"m-pad\" style=\"font-size:24px;\n                  font-weight:600;\n                  color:rgba(33,33,33,1);\n                  padding-top: 50px;\n                  padding-left: 50px;\n                  padding-right: 50px;\n                  text-align: center;\" colspan=\"2\">\n                                    パスワードのリセット\n                                </td>\n                            </tr>\n                            <tr>\n                                <td class=\"m-pad m-body\" style=\"font-size:14px;\n                  font-weight:400;\n                  color:rgba(33,33,33,1);\n                  padding-top: 24px;\n                  text-align: center;\n                  padding-left: 50px;\n                  padding-right: 50px;\n                  padding-bottom: 40px;\" colspan=\"2\">\n                                    {{ first_name | escape }} {{ last_name | escape }} 様<br><br>\n                                    ご利用のアカウントのパスワードを変更するリクエストがありました。<br>\n                                    ご自身でパスワードの変更を希望された場合は、以下のリンクをクリックしてパスワードをリセットしてください：<br>\n                                    <a href=\"{{ password_reset_url }}\" style=\"color:#1E7EC8;\">{{ password_reset_url }}</a>\n                                    <br><br>\n                                    もしリンクをクリックしても動作しない場合は、URLをブラウザにコピー＆ペーストしてお試しください。<br>\n                                    この変更にお心当たりがない場合は、本メールは無視していただいて問題ありません。現在のパスワードは引き続きそのままご利用いただけます。\n                                </td>\n                            </tr>\n\n                            <tr>\n                                <td style=\"font-size:14px;\n                  font-weight:400;\n                  color:rgba(33,33,33,1);\n                  text-align: center;\n                  padding-bottom: 32px;\" colspan=\"2\">\n                                </td>\n                            </tr>\n\n                            </tbody>\n                        </table>\n\n                    </td>\n                </tr>\n                <tr>\n                    <td>\n\n                        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"\n                               style=\"border-collapse: collapse; width: 100%;\">\n                            <tbody>\n                            <tr>\n                                <td style=\"background-color: #F7F7F7;padding-top: 32px;padding-bottom: 10px;text-align: center;font-size:16px;font-weight:600;color:#333;line-height:22px;\">\n                                    お困りですか？お気軽にお問い合わせください。\n                                </td>\n                            </tr>\n                            <tr>\n                                <td class=\"m-pad\" style=\"background-color: #F7F7F7;padding-left: 50px;padding-right: 50px;text-align: center;font-size:14px;color:#777;line-height:21px;\">\n                                    私たちは、お客様が気持ちよくご利用いただけるよう最善を尽くします。<br>\n                                    ご質問やご意見がございましたら、以下の連絡先までお気軽にご連絡ください。<br>\n                                    <a style=\"color: #1567BB; text-decoration: none;\"\n                                       href=\"mailto:{{ shop.email }}\" rel=\"noopener\" target=\"_blank\">【{{ shop.email }}】</a>\n                                    {% if shop.phone %}\n                                        <br>お電話： {{ shop.phone }}\n                                    {% endif %}\n                                </td>\n                            </tr>\n                            <tr>\n                                <td style=\"background-color: #F7F7F7;padding-top: 20px;padding-bottom: 32px;text-align: center;font-size:14px;color:#777;line-height:20px;\">\n                                    本メールは【{{ shop.name }}】より送信されました。\n                                </td>\n                            </tr>\n                            </tbody>\n                        </table>\n                    </td>\n                </tr>\n                </tbody>\n            </table>\n        </td>\n    </tr>\n    </tbody>\n</table>\n",
  "lang_emails": []
}
