{
  "type": 15,
  "category": 1,
  "status": 1,
  "subject": "【{{ shop.name }}】お支払い状況のご確認（注文番号：{{ order.order_number }}）",
  "body_html": "<table id=\"content_table\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"\n       style=\"border-collapse: collapse; width: 100%; background-color: #fff; font-family: -apple-system,BlinkMacSystemFont,'Hiragino Sans','Hiragino Kaku Gothic ProN','Yu Gothic',Meiryo,sans-serif;\">\n    <tbody>\n    <tr>\n        <td>\n            <style>@media only screen and (max-width:620px){.m-pad{padding-left:16px !important;padding-right:16px !important;}.m-body{font-size:16px !important;line-height:1.75 !important;} }</style>\n<table id=\"main_content\" align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse: collapse; width: 100%; max-width: 600px; border: 1px solid #ccc;\">\n                <tbody>\n                <tr>\n                    <td>\n                        <table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n                            <tr><td colspan=\"4\"></td></tr>\n                            <tr>\n                                {%- if shop.email_logo_url %}\n<td class=\"m-pad\" style=\"padding: 30px 0 20px 35px;\"><img style=\"max-width: 100px\" width=\"{{ shop.email_logo_width }}\" src=\"{{ shop.email_logo_url }}\" alt=\"{{ shop.name | escape }}\"></td>\n{%- endif %}\n<td class=\"m-pad\" style=\"padding: 40px; word-break: keep-all; white-space: nowrap;\">\n                                    <div style=\"font-size: 13px; color: #333; text-align: right;\">\n                                        ご注文番号：{{ order.order_number }}\n                                    </div>\n                                    <div style=\"font-size: 12px; color: #999; text-align: right;\">\n                                        注文日：{{ order.created_at }}\n                                    </div>\n                                </td>\n                            </tr>\n                            {% if order_confirm_img %}\n                            <tr><td colspan=\"4\"><img width=\"100%\" src=\"{{ order_confirm_img }}\" alt=\"\"></td></tr>\n                            {% endif %}\n                            <tr>\n                                <td class=\"m-pad\" colspan=\"4\" style=\"font-size:24px; font-weight:600; color:#212121; padding-top: 50px; padding-left: 50px; padding-right: 50px; text-align: center;\">\n                                    お支払い状況をご確認ください\n                                </td>\n                            </tr>\n                            <tr>\n                                <td class=\"m-pad m-body\" colspan=\"4\" style=\"font-size:14px; color:#212121; padding-top: 24px; padding-left: 50px; padding-right: 50px; padding-bottom: 40px; text-align: center; line-height: 26px;\">\n                                    {{ order.shippingAddress.first_name | escape }} {{ order.shippingAddress.last_name | escape }} 様<br><br>\nご注文のお支払いを確認しております。<br>ご利用のお支払い方法により、反映まで時間がかかる場合がございます。<br>お手続きの続行が必要な場合は、下のボタンからご注文画面をご確認ください。<br>すでにお支払い済みの場合は、重複してお支払いにならないようご注意ください。\n                                </td>\n                            </tr>\n                            {% if order.txn_id %}\n                            <tr>\n                                <td class=\"m-pad\" colspan=\"4\" style=\"padding: 0 50px 20px;\">\n                                    <div style=\"background-color: #fff8e1; border: 1px solid #ffe0b2; padding: 15px; border-radius: 4px; font-size: 14px; color: #333; line-height: 1.6;\">\n                                        <strong>■ コンビニ・銀行振込のお支払い情報</strong><br>\n                                        以下のリンクより、お支払い先（振込先口座や払込番号）をご確認ください。<br>\n                                        <div style=\"text-align: center; margin: 15px 0;\">\n                                            <a href=\"{{ shop.url }}/instructions/ja/{{ order.txn_id }}\" style=\"font-size: 16px; font-weight: bold; color: #1567BB; text-decoration: underline;\">\n                                                お支払い詳細ページへ\n                                            </a>\n                                        </div>\n                                        <div style=\"font-size: 12px; color: #d32f2f; border-top: 1px dashed #ffe0b2; padding-top: 10px;\">\n                                            <strong>【重要：銀行振込のお客様へ】</strong><br>\n                                            振込先口座はご注文ごとに異なる場合がございます。<br>\n                                            次回以降、新しくご注文される際は、<strong>必ずその都度届く新しいメールの口座情報</strong>をご確認の上、お振込みください（本メールの口座へは振り込まないでください）。\n                                        </div>\n                                    </div>\n                                </td>\n                            </tr>\n                            {% endif %}\n                            {% if order.view_url %}\n                            <tr>\n                                <td colspan=\"4\" style=\"text-align: center;\">\n                                    <a style=\"display: inline-block; text-decoration: none; font-size:14px; color:#FFFFFF; background:#333; border-radius: 19px; padding: 0 41px; line-height: 38px; height: 38px;\" href=\"{{ order.view_url }}\" target=\"_blank\" rel=\"noopener\">\n                                        ご注文内容を確認する\n                                    </a>\n                                </td>\n                            </tr>\n                            {% endif %}\n                            <tr style=\"text-align: center;\">\n                                <td colspan=\"4\" style=\"font-size:14px; line-height:20px; padding: 8px 0 32px;\">\n                                    <span style=\"color:#9c9c9c;\">または</span> <a style=\"color:#1567BB; text-decoration: underline;\" href=\"{{ shop.url }}\">ショップを見る</a>\n                                </td>\n                            </tr>\n                        </table>\n\n                        <!-- 配送先情報 -->\n                        <table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse; background-color: #F7F7F7;\">\n                            <tr>\n                                <td width=\"260\" valign=\"top\">\n                                    <div class=\"m-pad\" style=\"padding-left: 40px; padding-top: 40px; padding-bottom: 12px; font-size: 16px; font-weight: 500; color: #333;\">\n                                        配送先情報\n                                    </div>\n                                    <div class=\"m-pad\" style=\"padding-left: 40px; padding-bottom: 40px; padding-right: 10px; color: #777; font-size: 13px; line-height: 20px;\">\n                                        〒{{ order.shippingAddress.zip | escape }}<br>\n{{ order.shippingAddress.province_name | escape }}{{ order.shippingAddress.city | escape }}{{ order.shippingAddress.address_1 | escape }}{% if order.shippingAddress.address_2 %} {{ order.shippingAddress.address_2 | escape }}{% endif %}<br>\n{{ order.shippingAddress.first_name | escape }} {{ order.shippingAddress.last_name | escape }} 様<br>\n配送方法：{{ order.shipping_method_name | escape }}\n                                    </div>\n                                </td>\n                            </tr>\n                        </table>\n\n                        <!-- 商品明細 -->\n                        <table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\"><tr><td class=\"m-pad\" style=\"padding: 0 40px;\"><table border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n                            <tr>\n                                <td style=\"padding-top: 40px; font-size: 16px; font-weight: 500; color: #212121;\">ご注文内容</td>\n                            </tr>\n                            <tr>\n                                <td>\n                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; table-layout: fixed;\">\n                                        {% for line in order.items %}\n                                        <tr style=\"vertical-align: top;\">\n                                            <td rowspan=\"2\" style=\"width: 105px; padding-top: 32px;\">\n                                                <img width=\"85\" src=\"{{ line.image }}\" alt=\"{{ line.product_title | escape }}\">\n                                            </td>\n                                            <td colspan=\"2\" style=\"color: #777; font-size: 12px; line-height: 14px; padding: 32px 0 0; border-bottom: 1px solid #E5E5E5;\">\n                                                <div style=\"color: #333; font-size: 14px; line-height: 16px; padding-bottom: 2px;\">\n                                                    {{ line.product_title | escape }}\n                                                </div>\n                                                {% if line.variant_title %}\n                                                <div style=\"padding: 2px 0;\">バリエーション：{{ line.variant_title | escape }}</div>\n                                                {% endif %}\n                                                <div style=\"padding: 2px 0;\">単価：{{ order.symbol }}{{ line.curr_price }}</div>\n                                            </td>\n                                        </tr>\n                                        <tr style=\"font-size: 14px; color: #30354D;\">\n                                            <td style=\"text-align: left; padding: 8px 0;\">数量：{{ line.qty }}</td>\n                                            <td style=\"text-align: right; padding: 8px 0;\">{{ order.symbol }}{{ line.curr_row_price }}</td>\n                                        </tr>\n                                        {% endfor %}\n                                    </table>\n                                </td>\n                            </tr>\n                        </table></td></tr></table>\n\n                        <!-- 注文合計 -->\n                        <table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\"><tr><td class=\"m-pad\" style=\"padding: 0 40px 24px;\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse: collapse;\">\n                            <tr><td colspan=\"2\" style=\"border-top: 1px solid #E5E5E5;\"></td></tr>\n                            <tr>\n                                <td style=\"padding-top: 24px; padding-bottom: 12px; font-size:16px; font-weight:500; color:#212121;\">ご注文金額</td>\n                            </tr>\n                            <tr>\n                                <td style=\"color: #777; font-size: 14px;\">\n                                    <table width=\"100%\" style=\"border-collapse: collapse;\">\n                                        <tr>\n                                            <td>商品合計</td>\n                                            <td style=\"text-align: right;\">{{ order.symbol }}{{ order.curr_subtotal }}</td>\n                                        </tr>\n                                        <tr>\n                                            <td>送料</td>\n                                            <td style=\"text-align: right;\">{{ order.symbol }}{{ order.curr_shipping_total }}</td>\n                                        </tr>\n                                        {% if order.curr_tax %}\n                                        <tr>\n                                            <td>消費税</td>\n                                            <td style=\"text-align: right;\">{{ order.symbol }}{{ order.curr_tax }}</td>\n                                        </tr>\n                                        {% endif %}\n                                        {% if order.curr_insurance %}\n                                        <tr>\n                                            <td>保険料</td>\n                                            <td style=\"text-align: right;\">{{ order.symbol }}{{ order.curr_insurance }}</td>\n                                        </tr>\n                                        {% endif %}\n                                        {% if order.curr_tips %}\n                                        <tr>\n                                            <td>チップ</td>\n                                            <td style=\"text-align: right;\">{{ order.symbol }}{{ order.curr_tips }}</td>\n                                        </tr>\n                                        {% endif %}\n                                        {% if order.curr_subtotal_with_discount %}\n                                        <tr>\n                                            <td>割引</td>\n                                            <td style=\"text-align: right;\">-{{ order.symbol }}{{ order.curr_subtotal_with_discount }}</td>\n                                        </tr>\n                                        {% endif %}\n                                        <tr>\n                                            <td style=\"color: #333; font-weight: 500;\">合計金額（税込）</td>\n                                            <td style=\"color: #333; text-align: right; font-weight: 500;\">{{ order.symbol }}{{ order.curr_grand_total }}</td>\n                                        </tr>\n                                    </table>\n                                </td>\n                            </tr>\n                        </table></td></tr></table>\n\n                        <!-- フッター -->\n                        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse: collapse;\">\n                            <tr>\n                                <td style=\"background-color: #F7F7F7; padding-top: 32px; padding-bottom: 10px; text-align: center; font-size:16px; font-weight:600; color:#333;\">\n                                    ご不明な点がございましたら、お気軽にお問い合わせください。\n                                </td>\n                            </tr>\n                            <tr>\n                                <td class=\"m-pad\" style=\"background-color: #F7F7F7; padding-left: 50px; padding-right: 50px; text-align: center; font-size:14px; color:#777;\">\n                                    お問い合わせ先：\n                                    <a href=\"mailto:{{ shop.email }}\" style=\"color: #1567BB;\">【{{ shop.email }}】</a>\n                                    {% if shop.phone %}\n                                    <br>お電話：{{ shop.phone }}\n                                    {% endif %}\n                                </td>\n                            </tr>\n                            <tr>\n                                <td style=\"background-color: #F7F7F7; padding-top: 20px; padding-bottom: 32px; text-align: center; font-size:14px; color:#777;\">\n                                    本メールは【{{ shop.name }}】より送信されました。\n                                </td>\n                            </tr>\n                        </table>\n                    </td>\n                </tr>\n                </tbody>\n            </table>\n        </td>\n    </tr>\n    </tbody>\n</table>\n",
  "lang_emails": []
}
