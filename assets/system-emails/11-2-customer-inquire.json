{
  "type": 11,
  "category": 2,
  "status": 1,
  "subject": "【{{ shop.name }}】商品に関するお問い合わせを受け付けました",
  "body_html": "<table id=\"content_table\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%; background-color: #fff; font-family: -apple-system,BlinkMacSystemFont,'Hiragino Sans','Hiragino Kaku Gothic ProN','Yu Gothic',Meiryo,sans-serif;\">\n<tbody><tr><td>\n<style>@media only screen and (max-width:620px){.m-pad{padding-left:16px !important;padding-right:16px !important;}.m-body{font-size:16px !important;line-height:1.75 !important;} }</style>\n<table id=\"main_content\" align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse: collapse; width: 100%; max-width: 600px; border: 1px solid #ccc;\">\n<tbody><tr><td>\n<table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n<tr>\n{%- if shop.email_logo_url %}\n<td class=\"m-pad\" style=\"padding: 30px 0 20px 35px;\"><img style=\"max-width: 100px\" width=\"{{ shop.email_logo_width }}\" src=\"{{ shop.email_logo_url }}\" alt=\"{{ shop.name | escape }}\"></td>\n{%- endif %}\n<td></td>\n</tr>\n</table>\n{% if inquire_img %}<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\"><tr><td><img width=\"100%\" src=\"{{ inquire_img }}\" alt=\"\"></td></tr></table>{% endif %}\n<table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n<tr><td class=\"m-pad\" style=\"font-size:24px; font-weight:600; color:#212121; padding: 50px 50px 0; text-align: center;\">お問い合わせを受け付けました</td></tr>\n<tr><td class=\"m-pad m-body\" style=\"font-size:14px; color:#212121; padding: 24px 50px 40px; text-align: center; line-height: 26px;\">{{ name | escape }} 様<br><br>この度は{{ shop.name }}の商品についてお問い合わせいただき、ありがとうございます。<br>以下の内容で承りました。担当者より順次ご返信いたします。</td></tr>\n</table>\n<table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n<tr><td class=\"m-pad\" style=\"padding: 0 40px;\">\n<table width=\"100%\" style=\"border-collapse: collapse; border-top: 1px solid #E5E5E5;\">\n<tr><td style=\"padding: 24px 0 0; font-size:16px; font-weight:500; color:#212121;\">対象商品</td></tr>\n{% for line in products %}\n<tr><td style=\"padding: 16px 0 0;\">\n<table width=\"100%\" style=\"border-collapse: collapse;\"><tr>\n<td style=\"width: 105px;\"><img width=\"85\" src=\"{{ line.imageUrl }}\" alt=\"{{ line.title | escape }}\"></td>\n<td style=\"font-size: 14px; color: #333; vertical-align: top;\"><a href=\"{{ line.url }}\" target=\"_blank\" style=\"color: #333;\">{{ line.title | escape }}</a>{%- if line.price %}<div style=\"color: #777; font-size: 12px; padding-top: 4px;\">価格：{{ currency_symbol }}{{ line.price }}</div>{%- endif %}</td>\n</tr></table>\n</td></tr>\n{% endfor %}\n<tr><td style=\"padding-bottom: 24px;\"></td></tr>\n</table>\n</td></tr>\n</table>\n<table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n<tr><td class=\"m-pad\" style=\"padding: 0 40px;\">\n<table width=\"100%\" style=\"border-collapse: collapse; border-top: 1px solid #E5E5E5;\">\n<tr><td colspan=\"2\" style=\"padding: 24px 0 12px; font-size:16px; font-weight:500; color:#212121;\">お問い合わせ内容</td></tr>\n<tr style=\"color: #777; font-size: 14px;\"><td style=\"padding: 4px 0; width: 140px; vertical-align: top;\">お名前</td><td style=\"padding: 4px 0;\">{{ name | escape }}</td></tr>\n<tr style=\"color: #777; font-size: 14px;\"><td style=\"padding: 4px 0; width: 140px; vertical-align: top;\">メールアドレス</td><td style=\"padding: 4px 0;\">{{ email | escape }}</td></tr>\n<tr style=\"color: #777; font-size: 14px;\"><td style=\"padding: 4px 0; width: 140px; vertical-align: top;\">電話番号</td><td style=\"padding: 4px 0;\">{% if phone %}{{ phone | escape }}{% endif %}</td></tr>\n<tr style=\"color: #777; font-size: 14px;\"><td style=\"padding: 4px 0; width: 140px; vertical-align: top;\">お問い合わせ内容</td><td style=\"padding: 4px 0;\">{{ message | escape }}</td></tr>\n<tr><td colspan=\"2\" style=\"padding-bottom: 24px;\"></td></tr>\n</table>\n</td></tr>\n</table>\n<table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse; background-color: #F7F7F7;\">\n<tr><td class=\"m-pad\" style=\"padding: 32px 50px 10px; text-align: center; font-size:16px; font-weight:600; color:#333;\">ご不明な点がございましたら、お気軽にお問い合わせください。</td></tr>\n<tr><td class=\"m-pad\" style=\"padding: 0 50px; text-align: center; font-size:14px; color:#777; line-height: 21px;\">\nメール：<a href=\"mailto:{{ shop.email }}\" style=\"color: #1567BB; text-decoration: none;\">{{ shop.email }}</a>\n{% if shop.phone %}<br>お電話：{{ shop.phone }}{% endif %}\n</td></tr>\n<tr><td class=\"m-pad\" style=\"padding: 20px 50px 32px; text-align: center; font-size:14px; color:#777;\">本メールは【{{ shop.name }}】より送信されました。</td></tr>\n</table>\n</td></tr></tbody></table>\n</td></tr></tbody></table>",
  "lang_emails": []
}
