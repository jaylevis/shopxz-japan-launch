{
  "type": 7,
  "category": 1,
  "status": 1,
  "subject": "【{{ shop.name }}】ご注文キャンセルのお知らせ（注文番号：{{ order.order_number }}）",
  "body_html": "<table id=\"content_table\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%; background-color: #fff; font-family: -apple-system,BlinkMacSystemFont,'Hiragino Sans','Hiragino Kaku Gothic ProN','Yu Gothic',Meiryo,sans-serif;\">\n<tbody><tr><td>\n<style>@media only screen and (max-width:620px){.m-pad{padding-left:16px !important;padding-right:16px !important;}.m-body{font-size:16px !important;line-height:1.75 !important;} }</style>\n<table id=\"main_content\" align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse: collapse; width: 100%; max-width: 600px; border: 1px solid #ccc;\">\n<tbody><tr><td>\n<table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n<tr>\n{%- if shop.email_logo_url %}\n<td class=\"m-pad\" style=\"padding: 30px 0 20px 35px;\"><img style=\"max-width: 100px\" width=\"{{ shop.email_logo_width }}\" src=\"{{ shop.email_logo_url }}\" alt=\"{{ shop.name | escape }}\"></td>\n{%- endif %}\n<td class=\"m-pad\" style=\"padding: 40px; white-space: nowrap;\">\n<div style=\"font-size: 13px; color: #333; text-align: right;\">ご注文番号：{{ order.order_number }}</div>\n<div style=\"font-size: 12px; color: #999; text-align: right;\">ご注文日：{{ order.created_at }}</div>\n</td>\n</tr>\n</table>\n{% if order_confirm_img %}<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\"><tr><td><img width=\"100%\" src=\"{{ order_confirm_img }}\" alt=\"\"></td></tr></table>{% endif %}\n<table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n<tr><td class=\"m-pad\" style=\"font-size:24px; font-weight:600; color:#212121; padding: 50px 50px 0; text-align: center;\">ご注文がキャンセルされました</td></tr>\n<tr><td class=\"m-pad m-body\" style=\"font-size:14px; color:#212121; padding: 24px 50px 40px; text-align: center; line-height: 26px;\">{{ order.shippingAddress.first_name | escape }} {{ order.shippingAddress.last_name | escape }} 様<br><br>いつも{{ shop.name }}をご利用いただき、ありがとうございます。<br>下記のご注文はキャンセルとなりました。<br>すでにお支払い済みの場合は、返金手続きについて別途ご案内いたします。</td></tr>\n</table>\n<table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n<tr><td style=\"text-align: center;\"><a style=\"display: inline-block; text-decoration: none; font-size:14px; color:#FFFFFF; background:#333; border-radius: 19px; padding: 0 41px; line-height: 38px;\" href=\"{{ order.view_url }}\" target=\"_blank\" rel=\"noopener\">ご注文内容を確認する</a></td></tr>\n<tr><td style=\"text-align: center; font-size:14px; line-height:20px; padding: 8px 0 32px;\"><span style=\"color:#9c9c9c;\">または</span> <a style=\"color:#1567BB; text-decoration: underline;\" href=\"{{ shop.url }}\">ショップを見る</a></td></tr>\n</table>\n<table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n<tr><td class=\"m-pad\" style=\"padding: 40px 40px 0; font-size: 16px; font-weight: 500; color: #212121;\">キャンセルされた商品</td></tr>\n<tr><td class=\"m-pad\" style=\"padding: 0 40px;\">\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; table-layout: fixed;\">\n{% for line in order.items %}\n<tr style=\"vertical-align: top;\">\n<td rowspan=\"2\" style=\"width: 105px; padding-top: 32px;\"><img width=\"85\" src=\"{{ line.image }}\" alt=\"{{ line.product_title | escape }}\"></td>\n<td colspan=\"2\" style=\"color: #777; font-size: 12px; line-height: 16px; padding: 32px 0 0; border-bottom: 1px solid #E5E5E5;\">\n<div style=\"color: #333; font-size: 14px; padding-bottom: 2px;\">{{ line.product_title | escape }}</div>\n{% if line.variant_title %}<div style=\"padding: 2px 0;\">バリエーション：{{ line.variant_title | escape }}</div>{% endif %}\n<div style=\"padding: 2px 0;\">単価：{{ order.symbol }}{{ line.curr_price }}</div>\n</td>\n</tr>\n<tr style=\"font-size: 14px; color: #30354D;\">\n<td style=\"text-align: left; padding: 8px 0;\">数量：{{ line.qty }}</td>\n<td style=\"text-align: right; padding: 8px 0;\">{{ order.symbol }}{{ line.curr_row_price }}</td>\n</tr>\n{% endfor %}\n</table>\n</td></tr>\n</table>\n<table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n<tr><td class=\"m-pad\" style=\"padding: 24px 40px 0;\">\n<table width=\"100%\" style=\"border-collapse: collapse; border-top: 1px solid #E5E5E5;\">\n<tr><td colspan=\"2\" style=\"padding: 24px 0 12px; font-size:16px; font-weight:500; color:#212121;\">ご注文金額</td></tr>\n<tr style=\"color: #777; font-size: 14px;\"><td style=\"padding: 4px 0;\">商品合計</td><td style=\"text-align: right;\">{{ order.symbol }}{{ order.curr_subtotal }}</td></tr>\n<tr style=\"color: #777; font-size: 14px;\"><td style=\"padding: 4px 0;\">送料</td><td style=\"text-align: right;\">{{ order.symbol }}{{ order.curr_shipping_total }}</td></tr>\n{% if order.curr_tax %}<tr style=\"color: #777; font-size: 14px;\"><td style=\"padding: 4px 0;\">消費税</td><td style=\"text-align: right;\">{{ order.symbol }}{{ order.curr_tax }}</td></tr>{% endif %}\n{% if order.curr_insurance %}<tr style=\"color: #777; font-size: 14px;\"><td style=\"padding: 4px 0;\">保険料</td><td style=\"text-align: right;\">{{ order.symbol }}{{ order.curr_insurance }}</td></tr>{% endif %}\n{% if order.curr_tips %}<tr style=\"color: #777; font-size: 14px;\"><td style=\"padding: 4px 0;\">チップ</td><td style=\"text-align: right;\">{{ order.symbol }}{{ order.curr_tips }}</td></tr>{% endif %}\n{% if order.curr_subtotal_with_discount %}<tr style=\"color: #777; font-size: 14px;\"><td style=\"padding: 4px 0;\">割引</td><td style=\"text-align: right;\">-{{ order.symbol }}{{ order.curr_subtotal_with_discount }}</td></tr>{% endif %}\n<tr style=\"font-size: 14px;\"><td style=\"padding: 12px 0 24px; color: #333; font-weight: 500;\">合計金額（税込）</td><td style=\"padding: 12px 0 24px; text-align: right; color: #333; font-weight: 500;\">{{ order.symbol }}{{ order.curr_grand_total }}</td></tr>\n</table>\n</td></tr>\n</table>\n<table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse; background-color: #F7F7F7;\">\n<tr><td class=\"m-pad\" style=\"padding: 32px 50px 10px; text-align: center; font-size:16px; font-weight:600; color:#333;\">ご不明な点がございましたら、お気軽にお問い合わせください。</td></tr>\n<tr><td class=\"m-pad\" style=\"padding: 0 50px; text-align: center; font-size:14px; color:#777; line-height: 21px;\">\nメール：<a href=\"mailto:{{ shop.email }}\" style=\"color: #1567BB; text-decoration: none;\">{{ shop.email }}</a>\n{% if shop.phone %}<br>お電話：{{ shop.phone }}{% endif %}\n</td></tr>\n<tr><td class=\"m-pad\" style=\"padding: 20px 50px 32px; text-align: center; font-size:14px; color:#777;\">本メールは【{{ shop.name }}】より送信されました。</td></tr>\n</table>\n</td></tr></tbody></table>\n</td></tr></tbody></table>",
  "lang_emails": []
}
