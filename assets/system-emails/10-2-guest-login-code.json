  "subject": "【{{ shop.name }}】注文履歴の確認に必要な認証コード",
  "body_html": "<table id=\"content_table\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%; background-color: #fff; font-family: -apple-system,BlinkMacSystemFont,'Hiragino Sans','Hiragino Kaku Gothic ProN','Yu Gothic',Meiryo,sans-serif;\">\n    <tbody>\n    <tr>\n        <td>\n            <style>\n                .netease_mail_readhtml #fecify_content { border: 1px solid #ccc; }\n            </style>\n            <style>@media only screen and (max-width:620px){.m-pad{padding-left:16px !important;padding-right:16px !important;}.m-body{font-size:16px !important;line-height:1.75 !important;} }</style>\n<table id=\"fecify_content\" align=\"center\" border=\"0\" cellpadding=\"0\"\n                   cellspacing=\"0\" width=\"100%\" style=\"border-collapse: collapse; width: 100%; max-width: 600px; border: 1px solid #ccc;\">\n                <tbody>\n                    <tr>\n                        <td>\n                            <table align=\"center\" border=\"0\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"\n                                   style=\"border-collapse: collapse;\">\n                                <tbody>\n                                <tr>\n                                    {%- if shop.email_logo_url %}\n<td style=\"padding-bottom: 20px; padding-left: 24px; padding-top: 20px;\">\n                                        <img style=\"text-align: center;max-width: 100px\" width=\"{{ shop.email_logo_width }}\"\n                                             src=\"{{ shop.email_logo_url }}\" alt=\"{{ shop.name | escape }}\">\n                                    </td>\n{%- endif %}\n                                </tr>\n                                {% if guest_verifition_code_login %}<tr>\n                                    <td colspan=\"4\">\n                                        <img width=\"100%\" src=\"{{ guest_verifition_code_login }}\"\n                                             alt=\"\">\n                                    </td>\n                                </tr>{% endif %}\n                                <tr>\n                                    <td class=\"m-pad\" style=\"font-size:24px;\n                                                font-weight:600;\n                                                color:rgba(33,33,33,1);\n                                                padding-top: 50px;\n                                                padding-left: 50px;\n                                                padding-right: 50px;\n                                                text-align: center;\" colspan=\"4\">\n                                        注文履歴の確認\n                                    </td>\n                                </tr>\n                                <tr>\n                                    <td class=\"m-pad m-body\" style=\"font-size:14px;\n                                                font-weight:400;\n                                                color:rgba(33,33,33,1);\n                                                padding-top: 24px;\n                                                text-align: center;\n                                                padding-left: 50px;\n                                                padding-right: 50px;\" colspan=\"4\">\n                                        <div>\n                                            過去の注文履歴をご確認いただくために、下記の認証コードを入力してください。<br>\n                                            有効期限が切れた場合は、再度認証コードを取得してください。<br>\n                                            このメールにお心当たりがない場合は無視していただいて問題ありません。\n                                        </div>\n                                    </td>\n                                </tr>\n                                <tr>\n                                    <td style=\"\n                                                height:38px;\n                                                text-align: center;\n                                                border-radius:19px;padding-top: 20px;\" colspan=\"4\">\n                                        <span style=\"\n                                                    height:38px;\n                                                    text-decoration: none;\n                                                    -webkit-box-sizing: border-box;\n                                                    -moz-box-sizing: border-box;\n                                                    box-sizing: border-box;\n                                                    display: inline-block;\n                                                    text-align:center;\n                                                    font-size:14px;\n                                                    color:#FFFFFF;\n                                                    background:#333;\n                                                    border-radius: 19px;\n                                                    padding-right: 41px;\n                                                    padding-left: 41px;\n                                                    line-height: 38px;\">\n                                            {{ verification_code }}\n                                        </span>\n                                    </td>\n                                </tr>\n                                <tr style=\"background: #fff; text-align: center;\">\n                                    <td style=\"\n                                                font-size:12px;\n                                                \n                                                line-height:20px;\n                                                padding-top: 5px;\" colspan=\"4\">\n                                        <span style=\"color:rgba(156,156,156,1);\">\n                                            または\n                                        </span>\n                                        <a style=\"\n                                                    color:#1567BB;\n                                                    text-decoration: underline;\" href=\"{{ shop.url }}\">\n                                            ショップを見る\n                                        </a>\n                                    </td>\n                                </tr>\n                                <tr>\n                                    <td style=\"font-size:14px;\n                                                font-weight:400;\n                                                color:rgba(33,33,33,1);\n                                                text-align: center;\n                                                padding-bottom: 32px;\" colspan=\"2\">\n                                    </td>\n                                </tr>\n                                </tbody>\n                            </table>\n                        </td>\n                    </tr>\n                    <tr>\n                        <td>\n                            <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"\n                                   style=\"border-collapse: collapse; width: 100%;\">\n                                <tbody>\n                                <tr>\n                                    <td style=\"background-color: #F7F7F7;padding-top: 32px;padding-bottom: 10px;text-align: center;font-size:16px;font-weight:600;color:#333;line-height:22px;\">\n                                        お困りですか？ お気軽にお問い合わせください。\n                                    </td>\n                                </tr>\n                                <tr>\n                                    <td class=\"m-pad\" style=\"background-color: #F7F7F7;padding-left: 50px;padding-right: 50px;text-align: center;font-size:14px;color:#777;line-height:21px;\">\n                                        お客様が快適にご利用いただけるよう、私たちは最善を尽くします。<br>\n                                        ご質問やご意見などございましたら、下記メールアドレスまでお気軽にご連絡ください。<br>\n                                        <a style=\"color: #1567BB; text-decoration: none;\"\n                                           href=\"mailto:{{ shop.email }}\" rel=\"noopener\" target=\"_blank\">【{{ shop.email }}】</a>\n                                        {% if shop.phone %}\n                                            <br>お電話： {{ shop.phone }}\n                                        {% endif %}\n                                    </td>\n                                </tr>\n                                <tr>\n                                    <td style=\"background-color: #F7F7F7;padding-top: 20px;padding-bottom: 32px;text-align: center;font-size:14px;color:#777;line-height:20px;\">\n                                        このメールは【{{ shop.name }}】から送信されました。\n                                    </td>\n                                </tr>\n                                </tbody>\n                            </table>\n                        </td>\n                    </tr>\n                </tbody>\n            </table>\n        </td>\n    </tr>\n    </tbody>\n</table>\n",
  "lang_emails": []
}
